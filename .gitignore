node_modules/
dist/
src-tauri/target/
src-tauri/gen/
.vscode/
*.log

# Local Spotify credentials + audio cache written at runtime.
src-tauri/.cache/

# Local config. `.env.example` is the committed template.
.env

# Local visual references; keep them out of repository changes.
/screenshots/

# Merge-source archive (Version B) kept only as a local reference while
# reconciling with main; not part of the tracked project.
Rustify-main/
Rustify-main.zip

# External reverse-engineering reference repos, cloned on demand. Not part
# of the tracked project.
.research/

# Scratch state for long-running agent work sessions.
.agent-work/

# Local-only mcp-bridge capability grant. The committed template is
# capabilities/mcp-bridge.json.example — see CLAUDE.md's mcp-bridge section.
# This file must not exist for a default (no-features) build; cargo check
# fails validation if it is present without `--features mcp-bridge`.
src-tauri/capabilities/mcp-bridge.json

# rust-analyzer's out-of-tree build cache, when it lands at the workspace
# root instead of src-tauri/target/.
/target/
