# Copy to `.env` (same directory) and fill in.
# Real environment variables override this file.

# OAuth client ID used for Spotify Web API traffic (library, search, Connect).
#
# Not required for normal use: the app prompts for this on first launch and
# saves it to settings.json in the app data dir, so most users never need to
# touch this file. This variable is only useful for developers/packagers who
# want to skip that Setup screen (e.g. for a dev loop, or to ship a build
# pinned to one quota) — a value here always takes priority over whatever is
# saved through the UI.
#
# To get one:
#   1. https://developer.spotify.com/dashboard -> Create app
#   2. Add this exact redirect URI:  http://127.0.0.1:8899/login
#   3. Paste the Client ID below
#
# Note: playback still authenticates against Spotify's desktop client ID. Only
# Web API traffic moves onto yours, because self-registered apps are generally
# refused the `streaming` scope.
RUSTIFY_CLIENT_ID=

# Log filter. Uncomment for more detail when debugging.
#RUST_LOG=info,librespot=warn
#RUST_LOG=debug,librespot=info
